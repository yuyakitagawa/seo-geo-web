// Cloudflare Workers の設定（静的ファイルは out/、/api/* は worker/index.ts。移行の経緯は docs/progress_cloudflare.md）。
// これが無いと Cloudflare のビルドが Next.js を検出して OpenNext を走らせ、output: "export" と噛み合わずに落ちる。
{
  "name": "seo-geo-web",
  "compatibility_date": "2026-06-01",
  // fetchPage.ts の node:dns / node:net と、src/lib が読む process.env のため
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",
  // ダッシュボードで入れた実行時の変数（SUPABASE_* など）を、Git からのデプロイで消さない。
  // これが無いと wrangler deploy が設定ファイルに無い変数を削除する（2026-09-28、マージ直後の本番デプロイで消えた）
  "keep_vars": true,
  // Workers Logs（Observability）。閉鎖後は全リクエストが Worker を通る（Workers Free は1日10万リクエストまで。超えるとその日はエラーを返すだけで課金はされない）
  "observability": { "enabled": true },
  // ブランチの push は `wrangler preview` でプレビューを出す。このブロックが無いとそのコマンドが落ちる（中身は空でよい）
  "previews": {},
  // 2026-10-25 にサイトを閉鎖した。全URLを worker/index.ts が 410 で返すので、out/ の静的ファイルは配信しない。
  // 再開するときは閉鎖前のコミットの assets ブロック（out/ を配信・/api/* だけ Worker）に戻す
}
