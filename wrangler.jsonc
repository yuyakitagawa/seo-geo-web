// Cloudflare Workers の設定（静的ファイルは out/、/api/* は worker/index.ts。移行の経緯は docs/progress_cloudflare.md）。
// これが無いと Cloudflare のビルドが Next.js を検出して OpenNext を走らせ、output: "export" と噛み合わずに落ちる。
{
  "name": "seo-geo-web",
  "compatibility_date": "2026-06-01",
  // fetchPage.ts の node:dns / node:net と、src/lib が読む process.env のため
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",
  // Workers Logs（Observability）に /api/* の実行ログと CPU 時間を残す。無料枠は 1日20万件で、ページ配信は Worker を通らないので数えない
  "observability": { "enabled": true },
  // ブランチの push は `wrangler preview` でプレビューを出す。このブロックが無いとそのコマンドが落ちる（中身は空でよい）
  "previews": {},
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // /api/* だけ Worker を通す。ページ配信は Worker を起動しない（CPU時間も回数も使わない）
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
