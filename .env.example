# サイト
# 独自ドメイン接続後に設定。未設定ならVercelの本番URLを自動使用
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=SEO GEO Lab
# 公式X（@なし）。未設定なら seogeolab。空文字を入れるとフォロー導線とtwitter:siteが消える
NEXT_PUBLIC_X_SCREEN_NAME=

# 問い合わせ窓口（どちらか片方でよい。フォームの転送先・メール・外部フォーム・公式Xが1つも無いと /contact は404になり、フッターにも出ない）
# AdSense審査・E-E-A-Tの観点で連絡手段は用意する。実名は不要。サイト専用のメールかフォームURLを入れる
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_FORM_URL=

# /contact のフォームの転送先。LINEとメールの両方を設定すると両方に届く。1つも無ければフォームは表示しない
# LINE: 記事公開の通知（scripts/notify.ts）と同じMessaging APIのBot。Vercelの環境変数にも入れる
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
# メール: Resend（送信ドメインの認証が必要）。FROMは認証済みドメインのアドレス、TOは受け取りたいアドレス
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# 計測
NEXT_PUBLIC_GA_ID=

# ページ診断（/tools/page-audit）に入力されたURLの記録先。未設定なら記録しない（ローカル・プレビューは未設定でよい）
# 鍵は publishable（anon）。Supabase 側で seogeo_log_audit 関数の実行だけが許可されている
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# AdSense（審査通過後に設定）
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_INFEED_SLOT=
NEXT_PUBLIC_ADSENSE_ARTICLE_MID_SLOT=
NEXT_PUBLIC_ADSENSE_BOTTOM_SLOT=

# 記事生成（ローカル実行時。GitHub Actionsでは Secrets に設定）
ANTHROPIC_API_KEY=
